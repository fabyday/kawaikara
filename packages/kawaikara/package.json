{
  "name": "kawaikara",
  "version": "2.3.0",
  "description": "cho kwai OTT-viewer for discord",
  "main": "dist/main/main.js",
  "repository": "git@github.com:fabyday/kawaikara.git",
  "author": "fabyday",
  "private": true,
  "license": "MIT",
  "keywords": [
    "electron",
    "OTT-viewer",
    "Streaming-Viewer",
    "youtube-viewer",
    "youtube-downloader",
    "cho-kawai-viewer",
    "music-streaming",
    "Video-viewer"
  ],
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.2",
    "@semantic-release/release-notes-generator": "^14.0.3",
    "@storybook/addon-a11y": "^8.6.15",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-styling-webpack": "^3.0.0",
    "@storybook/addon-webpack5-compiler-swc": "^4.0.2",
    "@storybook/react": "^10.1.11",
    "@storybook/react-webpack5": "^8.6.15",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/discord-rpc": "^4.0.8",
    "@types/node": "^16.18.126",
    "@types/ps-tree": "^1.1.6",
    "@types/webpack-merge": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "babel-loader": "^9.2.1",
    "clean-webpack-plugin": "^4.0.0",
    "concurrently": "^8.2.2",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "dotenv-webpack": "^8.1.0",
    "electron": "https://github.com/castlabs/electron-releases#v35.2.2+wvcus",
    "electron-builder": "^24.9.1",
    "eslint-plugin-storybook": "^10.1.11",
    "fast-glob": "^3.3.3",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^29.7.0",
    "jest-electron": "^0.1.12",
    "node-gyp": "^12.1.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "prettier": "^3.4.2",
    "semantic-release": "^24.2.3",
    "semantic-release-yarn": "^3.0.2",
    "storybook": "^8.6.15",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.19.1",
    "wait-on": "^7.2.0",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1"
  },
  "scripts": {
    "start:dev": "pnpm run build:dev:all && cross-env IS_DEV=true electron .",
    "start:prod": "pnpm run build:prod:all && electron .",
    "build": "pnpm run build:prod:all",
    "build:prod:all": "pnpm run build:prod:main && pnpm run build:prod:preload && pnpm run build:prod:renderer",
    "build:prod:main": "webpack --config ./src/main/webpack.main.prod.ts",
    "build:prod:renderer": "webpack --config ./src/renderer/webpack.renderer.prod.ts",
    "build:prod:preload": "webpack --config ./src/preload/webpack.preload.prod.ts",
    "build:dev:all": "pnpm run build:dev:main && pnpm run build:dev:preload && pnpm run build:dev:renderer",
    "build:dev:main": "webpack --config ./src/main/webpack.main.dev.ts",
    "build:dev:renderer": "webpack --config ./src/renderer/webpack.renderer.dev.ts",
    "build:dev:preload": "webpack --config ./src/preload/webpack.preload.dev.ts",
    "typecheck": "pnpm run typecheck:main && pnpm run typecheck:preload && pnpm run typecheck:renderer",
    "typecheck:main": "tsc --noEmit -p src/main/tsconfig.json",
    "typecheck:preload": "tsc --noEmit -p src/preload/tsconfig.json",
    "typecheck:renderer": "tsc --noEmit -p src/renderer/tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "debug": "electron --inspect=8888 .",
    "package:dir": "pnpm run build:prod:all && cross-env KAWAI_SKIP_VMP_SIGN=true electron-builder --dir",
    "release:not_yet": "pnpm run build:prod:all && electron-builder --publish always",
    "release": "pnpm run build:prod:all && electron-builder --publish always",
    "make-cert:win": "electron-builder create-self-signed-cert -p fabyday & mkdir private & mv fabyday.pfx private/fabyday.pfx",
    "make-cert:mac": "openssl req -x509 -newkey rsa:4096 -keyout private/fabyday.key -out private/fabyday.crt -days 365 -nodes -subj \"/CN=localhost\" && openssl pkcs12 -export -out private/fabyday.pfx -inkey private/fabyday.key -in private/fabyday.crt -passout pass:",
    "lint": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "test": "jest",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^1.7.1",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.15.6",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/electron": "^1.6.12",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.21",
    "@types/lodash.isequal": "^4.5.8",
    "@types/react": "^18.2.47",
    "@types/react-dom": "^18.2.18",
    "chokidar": "^4.0.3",
    "cross-fetch": "^4.0.0",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.7",
    "electron-is-dev": "^3.0.1",
    "electron-log": "^5.0.3",
    "electron-preferences": "^2.8.2",
    "electron-updater": "^6.1.7",
    "fetch": "^1.1.0",
    "immer": "^9.0.21",
    "loadash": "^1.0.0",
    "lodash.isequal": "^4.5.0",
    "lodash": "^4.17.21",
    "patchright": "^1.57.0",
    "playwright": "^1.57.0",
    "playwright-core": "^1.57.0",
    "ps-tree": "^1.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.21.3",
    "react-scripts": "5.0.1",
    "reflect-metadata": "^0.2.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.0",
    "web-vitals": "^2.1.4"
  },
  "build": {
    "files": [
      "dist/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extends": null,
    "appId": "day.faby.kawaikara",
    "copyright": "Copyright fabyday",
    "electronDownload": {
      "mirror": "https://github.com/castlabs/electron-releases/releases/download/v"
    },
    "afterSign": "../../build/afterSign.js",
    "win": {
      "verifyUpdateCodeSignature": false,
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "kawaikara.ico",
      "extraResources": [
        {
          "from": "../../build",
          "to": ".",
          "filter": [
            "**/*.ico"
          ]
        },
        {
          "from": "../../config/locales",
          "to": "./locales"
        },
        {
          "from": "../../resources/icons",
          "to": "./icons"
        },
        {
          "from": "../../thirdparty",
          "to": "./thirdparty"
        }
      ],
      "publish": [
        "github"
      ]
    },
    "directories": {
      "buildResources": "../../build",
      "output": "output_dist"
    },
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../../resources/icons/app-kawaikara-mac.png",
      "extraResources": [
        {
          "from": "../../build",
          "to": ".",
          "filter": [
            "**/*.ico"
          ]
        },
        {
          "from": "../../config/locales",
          "to": "./locales"
        },
        {
          "from": "../../resources/icons",
          "to": "./icons"
        },
        {
          "from": "../../thirdparty",
          "to": "./thirdparty"
        }
      ],
      "publish": [
        "github"
      ]
    }
  }
}
