{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provider-locale.schema.json",
  "title": "Kawaikara Provider Locale",
  "description": "Provider-owned translations keyed first by locale and then by a stable message id.",
  "type": "object",
  "minProperties": 1,
  "additionalProperties": false,
  "patternProperties": {
    "^[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*$": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  }
}
