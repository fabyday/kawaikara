{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "kawaikara-dev.schema.json",
  "title": "Kawaikara Bundle Development Project",
  "description": "Controls the source entries and watch paths used by Kawaikara development mode.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entryPoints"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "description": "Development configuration schema version.",
      "const": 1
    },
    "sourceDirectory": {
      "description": "Source root relative to the project. Defaults to src.",
      "$ref": "definitions.schema.json#/definitions/safeRelativePath",
      "default": "src"
    },
    "entryPoints": {
      "description": "TypeScript or JavaScript entries relative to sourceDirectory.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "allOf": [
          { "$ref": "definitions.schema.json#/definitions/safeRelativePath" },
          { "pattern": "\\.[cm]?[jt]sx?$" }
        ]
      }
    },
    "watch": {
      "description": "Files or directories relative to the project that trigger a rebuild.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "definitions.schema.json#/definitions/safeRelativePath" },
      "default": ["src", "kawaikara.dev.json", "package.json"]
    }
  }
}
