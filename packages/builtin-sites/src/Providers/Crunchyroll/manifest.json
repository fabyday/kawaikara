{
  "schemaVersion": 1,
  "id": "kawaikara.crunchyroll",
  "name": "Crunchyroll",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation"],
  "contributes": {
    "address": { "hosts": ["crunchyroll.com"] },
    "shortcut": { "defaultKey": "Control+Alt+C" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "drm": true },
    "menu": { "category": "OTT", "order": 100 }
  }
}
