{
  "schemaVersion": 1,
  "id": "kawaikara.apple-music",
  "name": "Apple Music",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation", "network-interception"],
  "contributes": {
    "address": { "hosts": ["music.apple.com"] },
    "browserIdentity": {
      "userAgent": "chromium",
      "clientHints": "auto",
      "requestHosts": ["apple.com"]
    },
    "shortcut": { "defaultKey": "Control+Alt+M" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "defaultBrowserProfile": "apple" },
    "pictureInPicture": { "enabled": false },
    "menu": {
      "category": "Music",
      "order": 10,
      "icon": "https://music.apple.com/favicon.ico"
    }
  }
}
