{
  "schemaVersion": 1,
  "id": "kawaikara.video",
  "name": "Video",
  "description": "Play a local video file or an HLS stream.",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["internal-view", "plugin-view"],
  "contributes": {
    "shortcut": { "defaultKey": "Control+Alt+4" },
    "locale": {
      "resource": "locale.json",
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "pictureInPicture": { "enabled": true },
    "menu": {
      "category": "Video",
      "order": 0
    }
  }
}
