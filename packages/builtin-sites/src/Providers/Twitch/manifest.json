{
  "schemaVersion": 1,
  "id": "kawaikara.twitch",
  "name": "Twitch",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation"],
  "contributes": {
    "address": { "hosts": ["twitch.tv"] },
    "shortcut": { "defaultKey": "Control+Alt+W" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "menu": {
      "category": "Streaming",
      "order": 20,
      "icon": "https://www.twitch.tv/favicon.ico"
    }
  }
}
