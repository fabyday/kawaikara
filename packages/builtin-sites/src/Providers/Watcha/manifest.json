{
  "schemaVersion": 1,
  "id": "kawaikara.watcha",
  "name": "Watcha",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation"],
  "contributes": {
    "address": { "hosts": ["watcha.com"] },
    "shortcut": { "defaultKey": "Control+Alt+8" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "drm": true },
    "menu": {
      "category": "OTT",
      "order": 60,
      "icon": "https://watcha.com/favicon.ico"
    }
  }
}
