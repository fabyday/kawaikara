{
  "schemaVersion": 1,
  "id": "kawaikara.amazon-prime-video",
  "name": "Prime Video",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation"],
  "contributes": {
    "address": { "hosts": ["primevideo.com"] },
    "shortcut": { "defaultKey": "Control+Alt+6" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "drm": true },
    "pictureInPicture": { "enabled": true },
    "menu": {
      "category": "OTT",
      "order": 40,
      "icon": "https://www.primevideo.com/favicon.ico"
    }
  }
}
