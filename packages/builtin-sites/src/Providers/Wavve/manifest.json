{
  "schemaVersion": 1,
  "id": "kawaikara.wavve",
  "name": "Wavve",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation", "script-injection"],
  "contributes": {
    "address": { "hosts": ["wavve.com"] },
    "shortcut": { "defaultKey": "Control+Alt+7" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "drm": true },
    "pictureInPicture": { "enabled": true },
    "menu": {
      "category": "OTT",
      "order": 50,
      "icon": "https://www.wavve.com/favicon.ico"
    }
  }
}
