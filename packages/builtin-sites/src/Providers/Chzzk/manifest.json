{
  "schemaVersion": 1,
  "id": "kawaikara.chzzk",
  "name": "CHZZK",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation", "network-interception", "script-injection"],
  "contributes": {
    "address": { "hosts": ["chzzk.naver.com"] },
    "browserIdentity": {
      "userAgent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_14_6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
      "clientHints": "auto",
      "requestHosts": [
        "chzzk.naver.com",
        "naver.com",
        "pstatic.net",
        "akamaized.net",
        "ntruss.com",
        "naver.net"
      ]
    },
    "shortcut": { "defaultKey": "Control+Alt+Z" },
    "shortFormVideo": {
      "previous": true,
      "next": true,
      "autoAdvance": {
        "settingKey": "short-form-video.auto-advance",
        "defaultValue": true
      }
    },
    "pictureInPicture": { "enabled": true },
    "locale": {
      "resource": "locale.json",
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "menu": {
      "category": "Streaming",
      "order": 10,
      "icon": "https://chzzk.naver.com/favicon.ico"
    }
  }
}
