{
  "schemaVersion": 1,
  "id": "kawaikara.chzzk",
  "name": "CHZZK",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "plugins": [
    "Plugins/AdBlock",
    "Plugins/Quality",
    "Plugins/Clips",
    "Plugins/Upscaling"
  ],
  "permissions": [
    "navigation",
    "network-interception",
    "script-injection",
    "web-extension"
  ],
  "descriptors": {
    "webExtension": {
      "version": 2,
      "actions": [
        "open",
        "copy-link",
        "download"
      ],
      "toolbarAction": "open",
      "contextMenus": [
        {
          "id": "open-page",
          "action": "open",
          "title": "%webExtension.menu.open-page.title%",
          "contexts": [
            "page",
            "video"
          ],
          "when": "browser-menu"
        },
        {
          "id": "open-link",
          "action": "open",
          "title": "%webExtension.menu.open-link.title%",
          "contexts": [
            "link"
          ],
          "when": "browser-menu"
        },
        {
          "id": "copy-link-page",
          "action": "copy-link",
          "title": "%webExtension.menu.copy-link-page.title%",
          "contexts": [
            "page",
            "video"
          ],
          "when": "browser-menu"
        },
        {
          "id": "copy-link-link",
          "action": "copy-link",
          "title": "%webExtension.menu.copy-link-link.title%",
          "contexts": [
            "link"
          ],
          "when": "browser-menu"
        },
        {
          "id": "download-page",
          "action": "download",
          "title": "%webExtension.menu.download-page.title%",
          "contexts": [
            "page",
            "video"
          ],
          "when": "browser-menu"
        },
        {
          "id": "download-link",
          "action": "download",
          "title": "%webExtension.menu.download-link.title%",
          "contexts": [
            "link"
          ],
          "when": "browser-menu"
        }
      ],
      "actionDefinitions": {
        "open": {
          "title": "%webExtension.action.open.title%",
          "handler": "open"
        },
        "copy-link": {
          "title": "%webExtension.action.copy-link.title%",
          "handler": "share-link",
          "clipboard": true
        },
        "download": {
          "title": "%webExtension.action.download.title%",
          "handler": "download"
        }
      },
      "settings": [
        {
          "id": "browser-menu",
          "title": "%webExtension.setting.browser-menu.title%",
          "defaultValue": true
        },
        {
          "id": "player-menu",
          "title": "%webExtension.setting.player-menu.title%",
          "defaultValue": true
        }
      ],
      "domActions": [
        {
          "close": ".pzp-contextmenu-pane",
          "trigger": "video, .pzp-pc, .webplayer-internal-source-wrapper, [class*=\"pzp-pc__\"]",
          "target": ".pzp-contextmenu-pane .pzp-contextmenu-pane__list",
          "layout": "button-list",
          "itemClass": "pzp-ui-contextmenu-item pzp-contextmenu-pane__list-item",
          "buttonClass": "pzp-ui-contextmenu-item__button",
          "items": [
            {
              "id": "open",
              "action": "open",
              "title": "%webExtension.dom.player-context.open.title%",
              "when": "player-menu"
            },
            {
              "id": "copy-link",
              "action": "copy-link",
              "title": "%webExtension.dom.player-context.copy-link.title%",
              "when": "player-menu"
            },
            {
              "id": "download",
              "action": "download",
              "title": "%webExtension.dom.player-context.download.title%",
              "when": "player-menu"
            }
          ],
          "placement": "prepend",
          "id": "player-context",
          "event": "contextmenu",
          "requireVideo": true,
          "iconText": "K"
        }
      ]
    },
    "address": {
      "hosts": [
        "chzzk.naver.com"
      ]
    },
    "browserIdentity": {
      "userAgent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_14_6) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36",
      "clientHints": "auto",
      "requestHosts": [
        "chzzk.naver.com",
        "naver.com",
        "pstatic.net",
        "akamaized.net",
        "ntruss.com",
        "naver.net"
      ]
    },
    "shortcut": {
      "defaultKey": "Control+Alt+Z"
    },
    "shortFormVideo": {
      "previous": true,
      "next": true,
      "autoAdvance": {
        "settingKey": "short-form-video.auto-advance",
        "defaultValue": true
      }
    },
    "pictureInPicture": {
      "enabled": true
    },
    "locale": {
      "resource": "locale.json",
      "supportedLocales": [
        "ko-KR",
        "en-US",
        "ja-JP"
      ],
      "defaultLocale": "inherit"
    },
    "menu": {
      "category": "Streaming",
      "order": 10,
      "icon": "https://chzzk.naver.com/favicon.ico"
    }
  }
}
