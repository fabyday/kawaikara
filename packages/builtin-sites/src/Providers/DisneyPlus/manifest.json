{
  "schemaVersion": 1,
  "id": "kawaikara.disneyplus",
  "name": "Disney+",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation"],
  "contributes": {
    "address": { "hosts": ["disneyplus.com"] },
    "shortcut": { "defaultKey": "Control+Alt+3" },
    "locale": {
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "drm": true },
    "menu": {
      "category": "OTT",
      "order": 30,
      "icon": "https://www.disneyplus.com/favicon.ico"
    }
  }
}
