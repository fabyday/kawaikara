{
  "schemaVersion": 1,
  "id": "kawaikara.youtube",
  "name": "YouTube",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "plugins": [
    "Plugins/Shorts"
  ],
  "permissions": [
    "navigation",
    "script-injection",
    "cookies",
    "web-extension"
  ],
  "descriptors": {
    "webExtension": {
      "version": 2,
      "actions": [
        "open",
        "copy-link",
        "download"
      ],
      "toolbarAction": "open",
      "contextMenus": [
        {
          "id": "open-page",
          "action": "open",
          "title": "%webExtension.menu.open-page.title%",
          "contexts": [
            "page",
            "video"
          ],
          "when": "browser-menu"
        },
        {
          "id": "open-link",
          "action": "open",
          "title": "%webExtension.menu.open-link.title%",
          "contexts": [
            "link"
          ],
          "when": "browser-menu"
        },
        {
          "id": "copy-link-page",
          "action": "copy-link",
          "title": "%webExtension.menu.copy-link-page.title%",
          "contexts": [
            "page",
            "video"
          ],
          "when": "browser-menu"
        },
        {
          "id": "copy-link-link",
          "action": "copy-link",
          "title": "%webExtension.menu.copy-link-link.title%",
          "contexts": [
            "link"
          ],
          "when": "browser-menu"
        },
        {
          "id": "download-page",
          "action": "download",
          "title": "%webExtension.menu.download-page.title%",
          "contexts": [
            "page",
            "video"
          ],
          "when": "browser-menu"
        },
        {
          "id": "download-link",
          "action": "download",
          "title": "%webExtension.menu.download-link.title%",
          "contexts": [
            "link"
          ],
          "when": "browser-menu"
        }
      ],
      "actionDefinitions": {
        "open": {
          "title": "%webExtension.action.open.title%",
          "handler": "open"
        },
        "copy-link": {
          "title": "%webExtension.action.copy-link.title%",
          "handler": "share-link",
          "clipboard": true
        },
        "download": {
          "title": "%webExtension.action.download.title%",
          "handler": "download"
        }
      },
      "settings": [
        {
          "id": "browser-menu",
          "title": "%webExtension.setting.browser-menu.title%",
          "defaultValue": true
        },
        {
          "id": "player-menu",
          "title": "%webExtension.setting.player-menu.title%",
          "defaultValue": true
        }
      ],
      "domActions": [
        {
          "close": ".ytp-contextmenu",
          "trigger": "video, #movie_player, .html5-video-player",
          "target": ".ytp-contextmenu .ytp-panel-menu",
          "layout": "menu-item",
          "itemClass": "ytp-menuitem",
          "iconClass": "ytp-menuitem-icon",
          "labelClass": "ytp-menuitem-label",
          "contentClass": "ytp-menuitem-content",
          "items": [
            {
              "id": "open",
              "action": "open",
              "title": "%webExtension.dom.player-context.open.title%",
              "when": "player-menu"
            },
            {
              "id": "copy-link",
              "action": "copy-link",
              "title": "%webExtension.dom.player-context.copy-link.title%",
              "when": "player-menu"
            },
            {
              "id": "download",
              "action": "download",
              "title": "%webExtension.dom.player-context.download.title%",
              "when": "player-menu"
            }
          ],
          "placement": "prepend",
          "id": "player-context",
          "event": "contextmenu",
          "requireVideo": true,
          "iconText": "K"
        }
      ]
    },
    "address": {
      "hosts": [
        "youtube.com",
        "youtu.be"
      ]
    },
    "shortcut": {
      "defaultKey": "Control+Alt+5"
    },
    "shortFormVideo": {
      "previous": true,
      "next": true,
      "autoAdvance": {
        "settingKey": "short-form-video.auto-advance",
        "defaultValue": true
      },
      "publisherBan": {
        "settingKey": "short-form-video.banned-publishers"
      }
    },
    "pictureInPicture": {
      "enabled": true
    },
    "locale": {
      "resource": "locale.json",
      "supportedLocales": [
        "ko-KR",
        "en-US",
        "ja-JP"
      ],
      "defaultLocale": "inherit"
    },
    "isolation": {
      "defaultBrowserProfile": "google"
    },
    "menu": {
      "category": "Video",
      "order": 10,
      "icon": "https://www.youtube.com/favicon.ico"
    }
  }
}
