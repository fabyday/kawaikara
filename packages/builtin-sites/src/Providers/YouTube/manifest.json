{
  "schemaVersion": 1,
  "id": "kawaikara.youtube",
  "name": "YouTube",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "Provider.js",
  "permissions": ["navigation", "script-injection", "cookies"],
  "contributes": {
    "address": { "hosts": ["youtube.com", "youtu.be"] },
    "shortcut": { "defaultKey": "Control+Alt+5" },
    "shortFormVideo": {
      "previous": true,
      "next": true,
      "autoAdvance": {
        "settingKey": "short-form-video.auto-advance",
        "defaultValue": true
      },
      "publisherBan": {
        "settingKey": "short-form-video.banned-publishers"
      }
    },
    "pictureInPicture": { "enabled": true },
    "locale": {
      "resource": "locale.json",
      "supportedLocales": ["ko-KR", "en-US", "ja-JP"],
      "defaultLocale": "inherit"
    },
    "isolation": { "defaultBrowserProfile": "google" },
    "menu": {
      "category": "Video",
      "order": 10,
      "icon": "https://www.youtube.com/favicon.ico"
    }
  }
}
