---
interface Props {
  defaultPath?: string;
  localePaths?: Record<string, string>;
}

const {
  defaultPath = 'getstart/',
  localePaths = {
    ko: 'ko/getstart/',
    ja: 'ja/getstart/',
  },
} = Astro.props;
---

<script is:inline define:vars={{ defaultPath, localePaths }}>
  (() => {
    const languages =
      Array.isArray(navigator.languages) && navigator.languages.length > 0
        ? navigator.languages
        : [navigator.language || 'en'];

    let targetPath = defaultPath;
    for (const language of languages) {
      const code = String(language).toLowerCase();
      if (code.startsWith('ko')) {
        targetPath = localePaths.ko;
        break;
      }
      if (code.startsWith('ja') || code.startsWith('jp')) {
        targetPath = localePaths.ja;
        break;
      }
    }

    const target = new URL(targetPath, window.location.href);
    if (target.href !== window.location.href) {
      window.location.replace(target.href);
    }
  })();
</script>
