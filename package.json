{
    "name": "kawaikara",
    "version": "2.3.0",
    "description": "cho kwai OTT-viewer for discord",
    "main": "public/electron.js",
    "repository": "git@github.com:fabyday/kawaikara.git",
    "author": "fabyday",
    "private": true,
    "license": "MIT",
    "keywords": [
        "electron",
        "OTT-viewer",
        "Streaming-Viewer",
        "youtube-viewer",
        "youtube-downloader",
        "cho-kawai-viewer",
        "music-streaming",
        "Video-viewer"
    ],
    "engines": {
        "node": ">=22",
        "pnpm": ">=10"
    },
    "scripts": {
        "start:kawaikara:prod": "pnpm --filter kawaikara start:prod",
        "start:kawaikara:dev": "pnpm --filter kawaikara start:dev",
        "start:installer": "pnpm --filter installer build ",
        "build:kawaikara": "pnpm --filter kawaikara build",
        "build:installer": "pnpm",
        "story:kawaikara": "pnpm",
        "story:installer": "pnpm",
        "test:all": "pnpm",
        "test:kawaikara": "pnpm",
        "test:installer": "pnpm",
        "publish:all": "pnpm publish:kawaikara && pnpm publish:installer",
        "publish:kawaikara": "",
        "publish:installer": ""
    }
}
