{
  "name": "kawaikara",
  "version": "3.0.0",
  "productName": "Kawaikara",
  "description": "Kawaikara streaming site viewer",
  "main": "dist/main/main.js",
  "repository": "git@github.com:fabyday/kawaikara.git",
  "author": "fabyday",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "electron-mpv-video>node-gyp": "12.4.0"
    }
  },
  "scripts": {
    "build:packages": "pnpm --filter @kawaikara/site-api build && pnpm --filter @kawaikara/builtin-sites build",
    "build:native": "node scripts/build-macos-window-spaces.cjs",
    "build:app": "pnpm build:native && webpack --config webpack.config.cjs --mode production",
    "build": "pnpm build:packages && pnpm build:app",
    "build:dev": "pnpm build:packages && pnpm build:native && webpack --config webpack.config.cjs --mode development",
    "dev": "pnpm build:dev && cross-env KAWAI_DEV=true electron .",
    "package:dev": "node scripts/package-dev.cjs",
    "postinstall": "node scripts/install-electron-mpv.cjs",
    "widevine:auth": "node scripts/widevine.cjs auth",
    "widevine:verify": "node scripts/widevine.cjs verify",
    "capture:probe": "electron scripts/capture-probe/main.cjs",
    "start": "pnpm build && electron .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "update:build:stable": "node scripts/package-channel.cjs stable never",
    "update:build:staging": "node scripts/package-channel.cjs staging never",
    "update:build:nightly": "node scripts/package-channel.cjs nightly never",
    "update:publish:stable": "node scripts/package-channel.cjs stable always",
    "update:publish:staging": "node scripts/package-channel.cjs staging always",
    "update:publish:nightly": "node scripts/package-channel.cjs nightly always",
    "dist:stable": "pnpm update:build:stable",
    "dist:staging": "pnpm update:build:staging",
    "dist:nightly": "pnpm update:build:nightly",
    "release:stable": "pnpm update:publish:stable",
    "release:staging": "pnpm update:publish:staging",
    "release:nightly": "pnpm update:publish:nightly",
    "release:auto": "node scripts/package-channel.cjs auto always",
    "typecheck:packages": "pnpm build:packages",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "typecheck": "pnpm typecheck:packages && pnpm typecheck:app && pnpm typecheck:storybook"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kawaikara/builtin-sites": "workspace:*",
    "@kawaikara/kawai-ui": "github:Kawaikara/KawaiUi#0.1.1",
    "@kawaikara/site-api": "workspace:*",
    "discord-rpc": "4.0.1",
    "electron-log": "5.4.4",
    "electron-mpv-video": "0.1.1",
    "electron-updater": "6.8.9",
    "extract-zip": "2.0.1",
    "hls.js": "^1.7.0",
    "motion": "^13.0.0",
    "patchright": "^1.61.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/builder-vite": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@types/discord-rpc": "4.0.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "github:castlabs/electron-releases#v40.10.6+wvcus",
    "electron-builder": "26.15.7",
    "html-webpack-plugin": "^5.6.3",
    "storybook": "10.5.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "vite": "8.2.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
