{
  "name": "kawaikara",
  "version": "3.0.0",
  "productName": "Kawaikara",
  "description": "Kawaikara streaming site viewer",
  "main": "dist/main/main.js",
  "repository": "git@github.com:fabyday/kawaikara.git",
  "author": "fabyday",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "pnpm": {
    "overrides": {
      "electron-mpv-video>node-gyp": "12.4.0"
    }
  },
  "scripts": {
    "cert:mac": "bash scripts/create-macos-code-signing-cert.sh",
    "build:packages": "pnpm --filter @kawaikara/site-api build && pnpm --filter @kawaikara/builtin-sites build",
    "build:native": "node scripts/build-native.cjs",
    "build:app": "pnpm build:native && webpack --config webpack.config.cjs --mode production",
    "build": "pnpm build:packages && pnpm build:app",
    "build:dev": "pnpm build:packages && pnpm build:native && webpack --config webpack.config.cjs --mode development",
    "dev": "cross-env KAWAIKARA_DISTRIBUTION_BUILD=0 KAWAIKARA_UPDATE_TEST_BUILD=0 pnpm build:dev && cross-env KAWAI_DEV=true electron .",
    "package:dev": "node scripts/package-dev.cjs",
    "package:built-in-bundle": "node scripts/package-builtin-bundle.cjs",
    "postinstall": "node scripts/install-electron-mpv.cjs",
    "widevine:auth": "node scripts/widevine.cjs auth",
    "widevine:verify": "node scripts/widevine.cjs verify",
    "netflix:test:unit": "pnpm build:packages && node --test tests/external-login.test.cjs tests/widevine-packaging.test.cjs",
    "netflix:test:dom": "electron tests/netflix-login.electron.cjs",
    "developer-links:test:dom": "electron tests/developer-links.electron.cjs",
    "locale-video:test:unit": "node --test tests/localization-catalogs.test.cjs tests/locale-and-video-navigation.test.cjs tests/media-download-capability.test.cjs",
    "locale-video:test:dom": "electron tests/locale-and-video-navigation.electron.cjs",
    "capture:probe": "electron scripts/capture-probe/main.cjs",
    "start": "cross-env KAWAIKARA_DISTRIBUTION_BUILD=0 KAWAIKARA_UPDATE_TEST_BUILD=0 pnpm build && electron .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "update:build:stable": "node scripts/package-channel.cjs stable never",
    "update:build:staging": "node scripts/package-channel.cjs staging never",
    "update:build:nightly": "node scripts/package-channel.cjs nightly never",
    "update:publish:stable": "node scripts/package-channel.cjs stable always",
    "update:publish:staging": "node scripts/package-channel.cjs staging always",
    "update:publish:nightly": "node scripts/package-channel.cjs nightly always",
    "update:test:server": "node scripts/local-update-server.cjs",
    "update:test:build": "node scripts/build-update-test.cjs",
    "update:test:mac": "node scripts/smoke-update-test-mac.cjs",
    "update:test:unit": "node --experimental-strip-types --test tests/application-identity.test.cjs tests/local-update-server.test.cjs tests/local-update-feed.test.cjs tests/update-installation.test.cjs tests/windows-update-signature.test.cjs",
    "pip:test:unit": "pnpm build:packages && node --test tests/picture-in-picture-subtitles.test.cjs",
    "pip:test:dom": "electron tests/picture-in-picture-subtitles.electron.cjs",
    "pip:test:entry": "electron tests/picture-in-picture-entry.electron.cjs",
    "pip:test:preferences": "electron tests/subtitle-scale-control.electron.cjs",
    "transitions:test:unit": "node --test tests/pip-visibility-and-site-transition.test.cjs",
    "transitions:test:dom": "electron tests/pip-visibility-and-site-transition.electron.cjs",
    "transitions:test:handoff": "electron tests/site-handoff.electron.cjs",
    "dist:stable": "pnpm update:build:stable",
    "dist:staging": "pnpm update:build:staging",
    "dist:nightly": "pnpm update:build:nightly",
    "release:stable": "pnpm update:publish:stable",
    "release:staging": "pnpm update:publish:staging",
    "release:nightly": "pnpm update:publish:nightly",
    "release:auto": "node scripts/package-channel.cjs auto always",
    "typecheck:packages": "pnpm build:packages",
    "typecheck:app": "tsc --noEmit -p tsconfig.json",
    "typecheck:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "typecheck": "pnpm docs:source:check && pnpm typecheck:packages && pnpm typecheck:app && pnpm typecheck:storybook",
    "docs:source:check": "node scripts/source-documentation.cjs",
    "docs:source": "pnpm docs:source:check && typedoc"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@kawaikara/builtin-sites": "workspace:*",
    "@kawaikara/kawai-ui": "github:Kawaikara/KawaiUi#0.1.1",
    "@kawaikara/site-api": "workspace:*",
    "discord-rpc": "4.0.1",
    "electron-log": "5.4.4",
    "electron-mpv-video": "0.1.1",
    "electron-updater": "6.8.9",
    "esbuild": "^0.27.0",
    "extract-zip": "2.0.1",
    "hls.js": "^1.7.0",
    "motion": "^13.0.0",
    "patchright": "^1.61.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/builder-vite": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@types/discord-rpc": "4.0.11",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.0.5",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "github:castlabs/electron-releases#v40.10.6+wvcus",
    "electron-builder": "26.15.7",
    "html-webpack-plugin": "^5.6.3",
    "storybook": "10.5.7",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.2",
    "typedoc": "0.28.20",
    "typedoc-plugin-missing-exports": "4.1.4",
    "typescript": "^5.8.3",
    "vite": "8.2.1",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1"
  }
}
