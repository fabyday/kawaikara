{
    "name": "kawaikara-workspace",
    "version": "2.3.0",
    "description": "cho kwai OTT-viewer for discord",
    "repository": "git@github.com:fabyday/kawaikara.git",
    "author": "fabyday",
    "private": true,
    "license": "MIT",
    "keywords": [
        "electron",
        "OTT-viewer",
        "Streaming-Viewer",
        "youtube-viewer",
        "youtube-downloader",
        "cho-kawai-viewer",
        "music-streaming",
        "Video-viewer"
    ],
    "engines": {
        "node": ">=22",
        "pnpm": ">=10"
    },
    "scripts": {
        "dev": "pnpm --filter kawaikara start:dev",
        "start": "pnpm --filter kawaikara start:prod",
        "start:kawaikara:prod": "pnpm --filter kawaikara start:prod",
        "start:kawaikara:dev": "pnpm --filter kawaikara start:dev",
        "build": "pnpm --filter kawaikara build",
        "build:kawaikara": "pnpm --filter kawaikara build",
        "build:dev": "pnpm --filter kawaikara build:dev:all",
        "build:prod": "pnpm --filter kawaikara build:prod:all",
        "typecheck": "pnpm --filter kawaikara typecheck",
        "typecheck:kawaikara": "pnpm --filter kawaikara typecheck",
        "storybook:kawaikara": "pnpm --filter kawaikara storybook",
        "test:kawaikara": "pnpm --filter kawaikara test",
        "package:kawaikara:dir": "pnpm --filter kawaikara package:dir",
        "docs:dev": "pnpm --filter kawaikara-docs dev",
        "docs:build": "pnpm --filter kawaikara-docs build",
        "docs:preview": "pnpm --filter kawaikara-docs preview",
        "publish:kawaikara": ""
    }
}
