# Copy this file to .env.local. Never commit the populated .env.local file.
KAWAIKARA_EVS_ACCOUNT=your-castlabs-account
KAWAIKARA_EVS_PASSWORD="your-castlabs-password"

# Optional: package scripts automatically find a Conda environment named vmp.
# KAWAIKARA_EVS_CONDA_ENV=vmp

# Optional: use a specific Python executable instead of automatic discovery.
# KAWAIKARA_EVS_PYTHON=/absolute/path/to/python
