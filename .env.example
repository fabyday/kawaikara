# Copy this file to .env.local. Never commit the populated .env.local file.

# Discord Rich Presence application credentials.
# Create an application in the Discord Developer Portal and copy these values.
DISCORD_APP_ID=your-discord-application-id

# Castlabs EVS credentials used for development packaging.
KAWAIKARA_EVS_ACCOUNT=your-castlabs-account
KAWAIKARA_EVS_PASSWORD="your-castlabs-password"

# Optional: package scripts automatically find a Conda environment named vmp.
# KAWAIKARA_EVS_CONDA_ENV=vmp

# Optional: use a specific Python executable instead of automatic discovery.
# KAWAIKARA_EVS_PYTHON=/absolute/path/to/python

# Last-resort fallback for GPU/driver combinations that render incorrectly.
# This disables Chromium compositing and libmpv hardware decoding, so video can
# stutter at high resolutions. Leave it unset unless a driver workaround is needed.
# KAWAIKARA_FORCE_SOFTWARE_RENDERING=1

# Optional runtime file-log verbosity: error, warn, info, verbose, debug, silly.
# KAWAIKARA_LOG_LEVEL=debug
